# Snowflake credentials (used by dbt profiles.yml)
SNOWFLAKE_ACCOUNT=your_account.region.cloud
SNOWFLAKE_USER=DBT_USER
SNOWFLAKE_PASSWORD=your_password

# Fivetran (used by Airflow connection, not directly by dbt)
FIVETRAN_API_KEY=your_fivetran_api_key
FIVETRAN_API_SECRET=your_fivetran_api_secret

# Airflow variables (set via `airflow variables set`)
# zendesk_fivetran_connector_id=your_connector_id
# dbt_project_dir=/path/to/dbt_project
# dbt_profiles_dir=/path/to/dbt_project
